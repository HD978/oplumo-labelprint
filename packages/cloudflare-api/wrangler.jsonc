{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oplumo-label-studio-v2-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oplumo-label-studio-v2",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "oplumo-label-studio-v2-files" }],
  "durable_objects": { "bindings": [{ "name": "JOBS", "class_name": "LabelJob" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LabelJob"] }],
  "vars": { "APP_ORIGIN": "http://localhost:5173", "LOCAL_DEV": "true" },
  "observability": { "enabled": true }
}
